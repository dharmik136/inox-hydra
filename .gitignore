# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite WAL & temporary database files
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm

# Environment & credentials
.env
.env.local
.env.*.local
*.key
*.token

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# Build & Temporary directories
build/
dist/
build_artifacts/
*.egg-info/
.system_generated/

# Runtime user media (regenerated by the app, never source)
studio/assets/uploads/
studio/assets/generated/
studio/data/media/
studio/data/*.json

# Browser-automation and QA debris
.playwright-mcp/
scratch/

# Staged package content (regenerated by tools/prepare_package.py)
studio/docs/

# Live user database. Holds real drafts, leads and an encrypted LinkedIn
# session. It is user state, not source, and it is recreated by init_db().
studio/data/*.db
# Database backups. These hold the same real people the live database does:
# names, headlines, profile URLs, the text of comments they wrote, and the
# encrypted session vault. The rule above only covers studio/data/*.db, one
# level deep, so backups written into a subdirectory were committed by a
# routine `git add -A` and shipped in every clone.
studio/data/backups/
*.db-wal
*.db-shm

studio/backups/
studio/logs/
# ETag cache written by the intelligence sync engine at runtime.
studio/data/.intelligence_etag
# Harvested third party content. 390 LinkedIn posts from 240 named authors.
# Nothing reads it at runtime (inspirations are seeded from database.py), and
# it is not ours to redistribute.
studio/data/taplio_vault_archive_backup.json


# Chrome extension signing key. Whoever holds this can publish an update that
# every installed copy of the extension will accept as genuine. It is a
# credential, not source, and it must never enter the repository.
*.pem
studio/extension.pem
# Packaged extension build output, reproducible from studio/extension/.
*.crx
studio/extension.crx

# Desktop shell build output. The payload is staged from the portable builder
# on every build, and the Rust target directory is enormous.
desktop/payload/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# The local API token lives here in a source checkout, because get_app_home()
# resolves to studio/ whenever studio/data exists. It is a bearer credential
# for this machine's studio, and it has no file extension, so nothing else
# would have caught it. This is the same one-git-add-away shape as the
# extension key.
studio/vault/

# Written by the desktop workflow when signing credentials are present. It
# carries no secret itself, but it must not be committed: a signCommand in the
# tracked config would make every local build try to reach a signing service
# that is not configured.
desktop/signing.json
