{
  "manifest_version": 3,
  "name": "LinkedIn Studio Bridge (LocalTaplio)",
  "version": "2.5.1",
  "description": "Docks Personal LinkedIn Studio beside LinkedIn with live session synchronization and 1-click post injection.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Studio Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
