{
  "manifest_version": 3,
  "name": "Inox Hydra Bridge",
  "version": "2.12.0",
  "description": "Brings what you see on your own LinkedIn pages into Inox Hydra on this computer, and places your drafts in LinkedIn's composer.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inox Hydra Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["card_urns.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["content.js", "own_pages.js", "own_insights.js"],
      "run_at": "document_idle"
    }
  ]
}
